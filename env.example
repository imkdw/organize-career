# 이 파일을 .env로 복사한 뒤 값을 채우세요 (cp env.example .env)
# 환경변수는 src/config.ts 한 곳에서만 읽습니다.

# GitHub — https://github.com/settings/tokens (repo 스코프)
GITHUB_TOKEN=
GITHUB_USERNAME=

# Atlassian Cloud (Jira + Confluence 공용) — https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_BASE_URL=https://your-org.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
